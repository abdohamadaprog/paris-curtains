rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // الأدمن = عنده custom claim اسمه admin، أو له مستند في admins/{uid}.
    // مفيش أي إيميل مكتوب هنا. الصلاحية بتتمنح من Firebase Console أو Admin SDK بس.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // قائمة الأدمن: التطبيق ممنوع يكتب فيها نهائيًا.
    // والمستخدم يقدر يقرا مستنده هو بس (عشان التطبيق يعرف هو أدمن ولا لأ).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // المعرض والإكسسوارات والصور الترويجية:
    // قراءة عامة لكل مستخدمي التطبيق، والتعديل للأدمن فقط
    match /gallery_images/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promo_images/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /accessories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // إعدادات عامة يقراها كل زائر (مش بيانات حساسة): زي عدد صور الرئيسية.
    // الكتابة من لوحة الإدارة بس.
    match /public_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // حقل نصي اختياري: غايب أو null أو نص بطول معقول
    // (بيقبل null عشان العملاء القدام اللي ممكن يكون عندهم حقول فاضية)
    function optString(d, key, maxLen) {
      return !(key in d) || d[key] == null ||
        (d[key] is string && d[key].size() <= maxLen);
    }

    // فحص بسيط لشكل بيانات العميل (بيمنع بيانات غريبة أو ضخمة)
    function validClient(d) {
      return optString(d, 'name', 240)
        && optString(d, 'phone', 80)
        && optString(d, 'address', 600)
        && optString(d, 'notes', 4000)
        && (!('work_stage' in d) ||
            (d.work_stage is int && d.work_stage >= 1 && d.work_stage <= 4))
        && (!('installation_done' in d) || d.installation_done is bool);
    }

    // فحص الفاتورة المحفوظة جوه مستند العميل (حقل invoice).
    // الهدف: منع أي كتابة ضخمة أو شكلها غلط (سقف للدفعات والبنود والحالة).
    function validInvoice(d) {
      return !('invoice' in d) || d.invoice == null || (
        d.invoice is map
        && d.invoice.size() <= 60
        && (!('payments' in d.invoice) ||
            (d.invoice.payments is list && d.invoice.payments.size() <= 300))
        && (!('apt_custom_lines' in d.invoice) ||
            (d.invoice.apt_custom_lines is list
             && d.invoice.apt_custom_lines.size() <= 300))
        && (!('balc_custom_lines' in d.invoice) ||
            (d.invoice.balc_custom_lines is list
             && d.invoice.balc_custom_lines.size() <= 300))
        && (!('status' in d.invoice) ||
            d.invoice.status in ['unpaid', 'partial', 'paid', 'overpaid'])
        && (!('total' in d.invoice) || d.invoice.total is number)
        && (!('subtotal' in d.invoice) || d.invoice.subtotal is number)
        && (!('discount_amount' in d.invoice) ||
            d.invoice.discount_amount is number)
      );
    }

    // بيانات العملاء والفواتير والأجندة: للأدمن فقط.
    // الفاتورة محفوظة جوه مستند العميل (حقل invoice) فبتتغطى بنفس القاعدة.
    // الحذف مش مسموح غير لو نسخة العميل اتحفظت في clients_archive في نفس
    // العملية (batch)، يعني مفيش حذف نهائي للبيانات.
    match /clients/{clientId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && validClient(request.resource.data)
        && validInvoice(request.resource.data);
      allow delete: if isAdmin() &&
        existsAfter(/databases/$(database)/documents/clients_archive/$(clientId));

      // مقاسات العميل: clients/{clientId}/details/main
      match /details/{docId} {
        allow read, create, update: if isAdmin();
        allow delete: if isAdmin() &&
          existsAfter(/databases/$(database)/documents/clients_archive/$(clientId)/details/$(docId));
      }
    }

    // أرشيف العملاء المحذوفين: الأدمن يقرا ويضيف ويعدّل (علامة الاسترجاع)،
    // لكن الحذف النهائي ممنوع تمامًا من التطبيق.
    match /clients_archive/{clientId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;

      match /details/{docId} {
        allow read, create, update: if isAdmin();
        allow delete: if false;
      }
    }

    // أجهزة الأدمن لتنبيهات الأجندة: التطبيق بيسجّل توكن الجهاز بس،
    // والقراءة والتنظيف من Cloud Functions.
    match /admin_devices/{tokenId} {
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['token', 'uid', 'platform', 'updated_at']);
      allow read, delete: if false;
    }

    // حالة آخر نسخة احتياطية: بتتكتب من Cloud Function بس، والأدمن يقرا.
    match /app_meta/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // إعدادات التطبيق: settings/prices (الأسعار) و settings/telegram_backup
    // (بوت نسخة الصور على تليجرام). الاتنين للأدمن فقط.
    match /settings/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && (
        (docId == 'prices'
          && request.resource.data.keys().hasOnly(['prices', 'updated_at'])
          && request.resource.data.get('prices', {}) is map
          && request.resource.data.get('prices', {}).size() <= 60)
        ||
        (docId == 'telegram_backup'
          && request.resource.data.keys().hasOnly(
               ['bot_token', 'chat_id', 'enabled', 'updated_at'])
          && request.resource.data.get('bot_token', '') is string
          && request.resource.data.get('chat_id', '') is string
          && request.resource.data.get('enabled', true) is bool)
      );
      allow delete: if false;
    }

    // أي مسار تاني غير مذكور فوق ممنوع تلقائيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
