rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // الأدمن = عنده custom claim اسمه admin، أو له مستند في admins/{uid}.
    // مفيش أي إيميل مكتوب هنا. الصلاحية بتتمنح من Firebase Console أو Admin SDK بس.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // قائمة الأدمن: التطبيق ممنوع يكتب فيها نهائيًا.
    // والمستخدم يقدر يقرا مستنده هو بس (عشان التطبيق يعرف هو أدمن ولا لأ).
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // حقل نصي اختياري: غايب أو null أو نص بطول معقول
    // (بيقبل null عشان العملاء القدام اللي ممكن يكون عندهم حقول فاضية)
    function optString(d, key, maxLen) {
      return !(key in d) || d[key] == null ||
        (d[key] is string && d[key].size() <= maxLen);
    }

    // فحص بسيط لمستند صورة (معرض/ترويجي): لازم يكون فيه url نصي بطول معقول
    function validImageDoc(d) {
      return d.get('url', '') is string
        && d.get('url', '').size() > 0
        && d.get('url', '').size() <= 2048
        && optString(d, 'category', 100)
        && optString(d, 'accessory_type', 100)
        && optString(d, 'heavy_fabric', 100)
        && optString(d, 'light_fabric', 100);
    }

    // المعرض والإكسسوارات والصور الترويجية:
    // قراءة عامة لكل مستخدمي التطبيق، والتعديل للأدمن فقط
    match /gallery_images/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validImageDoc(request.resource.data);
      allow delete: if isAdmin();
    }
    match /promo_images/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validImageDoc(request.resource.data);
      allow delete: if isAdmin();
    }
    match /accessories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // فحص بسيط لشكل بيانات العميل (بيمنع بيانات غريبة أو ضخمة)
    function validClient(d) {
      return optString(d, 'name', 120)
        && optString(d, 'phone', 40)
        && optString(d, 'address', 300)
        && optString(d, 'notes', 2000)
        && (!('work_stage' in d) ||
            (d.work_stage is int && d.work_stage >= 1 && d.work_stage <= 4));
    }

    // فحص الفاتورة المحفوظة جوه مستند العميل (حقل invoice).
    // الـ Rules مبتقدرش تقيس حجم المستند بالبايت، فبنحدّ عدد الحقول وعدد
    // الدفعات والبنود عشان المستند ميقربش من حد 1MB.
    function validInvoice(d) {
      return !('invoice' in d) || d.invoice == null || (
        d.invoice is map
        && d.invoice.size() <= 40
        && (!('payments' in d.invoice) ||
            (d.invoice.payments is list && d.invoice.payments.size() <= 200))
        && (!('apt_custom_lines' in d.invoice) ||
            (d.invoice.apt_custom_lines is list
              && d.invoice.apt_custom_lines.size() <= 200))
        && (!('balc_custom_lines' in d.invoice) ||
            (d.invoice.balc_custom_lines is list
              && d.invoice.balc_custom_lines.size() <= 200))
        && (!('status' in d.invoice) ||
            d.invoice.status in ['unpaid', 'partial', 'paid', 'overpaid'])
      );
    }

    // بيانات العملاء والفواتير والأجندة: للأدمن فقط (قراءة وكتابة)
    // الفاتورة محفوظة جوه مستند العميل (حقل invoice) فبتتغطى بنفس القاعدة.
    match /clients/{clientId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && validClient(request.resource.data)
        && validInvoice(request.resource.data);

      // مقاسات العميل: clients/{clientId}/details/main
      match /details/{docId} {
        allow read, write: if isAdmin();
      }
    }

    // أي مسار تاني غير مذكور فوق ممنوع تلقائيًا
  }
}
